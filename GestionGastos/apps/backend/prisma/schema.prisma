generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(USER)
  incomes   Income[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Income {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  fixedSalary    Float    @default(12000.00)
  variableIncome Float    @default(13000.00)
  taxPercentage  Float    @default(0.05)
  month          Int
  year           Int
  createdAt      DateTime @default(now())
}